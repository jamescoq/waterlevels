{
  "name": "stavvody",
  "version": "0.0.0",
  "private": true,
  "description": "Map of Czech reservoir water levels at stavvody.cz, built from the five Povodí portals",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "NODE_EXTRA_CA_CERTS=certs/intermediates.pem tsx src/scraper/probe.ts",
    "scrape": "NODE_EXTRA_CA_CERTS=certs/intermediates.pem tsx src/scraper/scrape.ts",
    "reparse": "tsx src/scraper/reparse.ts",
    "alerts": "tsx src/scraper/alerts.ts",
    "registry:build": "NODE_EXTRA_CA_CERTS=certs/intermediates.pem tsx scripts/registry/build.ts",
    "registry:coordinates": "tsx scripts/registry/coordinates.ts",
    "derive": "tsx src/derive/run.ts",
    "map:build": "tsx scripts/map/build.ts",
    "map:preview": "tsx scripts/map/preview.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:data": "tsx scripts/dev-data.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "cheerio": "1.2.0",
    "preact": "10.29.8",
    "proj4": "2.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "geotiff": "3.0.5",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "mapshaper": "0.7.101",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
